# Fork registry config — LOCAL BUILDS.
#
# Copy to `fork.env` (same directory) and fill in. `fork.env` is deliberately
# NOT gitignored in the public .gitignore (upstream file); it is excluded via
# .git/info/exclude — this fork is public and the real registry host must not
# be committed (see docs/fork-maintenance.md).
#
# The CI worker reads the SAME keys from GitHub repo VARIABLES
# (FORK_REGISTRY, FORK_NAMESPACE) + SECRETS (FORK_REGISTRY_USER,
# FORK_REGISTRY_TOKEN) — a workflow cannot read a gitignored file.
#
# Used by scripts/fork/build-images.sh.

# Registry host (no scheme, no trailing slash) — e.g. gitea.example.com
FORK_REGISTRY=

# Namespace under the registry. Default: medali
FORK_NAMESPACE=medali

# Push credentials. Leave empty if you already ran `podman login`/`docker login`
# against FORK_REGISTRY — the script reuses that session.
FORK_REGISTRY_USER=
FORK_REGISTRY_TOKEN=
